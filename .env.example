# SQLite file used locally by @libsql/client. Point this at a hosted
# Turso/libsql URL in production (e.g. libsql://your-db.turso.io).
DATABASE_URL=file:./guestpilot.db

# Only needed when DATABASE_URL is a hosted Turso database.
# DATABASE_AUTH_TOKEN=

# Generate with: openssl rand -base64 32
AUTH_SECRET=
